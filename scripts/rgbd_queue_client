#!/usr/bin/env python3
"""取图服务客户端：显示摘要，不把数 MB 图像数组打印到终端。"""
import argparse
import json
import rclpy
from rgbd_image_queue.srv import GetImage, GetImageBatch

OPERATIONS = {
    "latest_color": GetImage.Request.LATEST_COLOR,
    "latest_depth": GetImage.Request.LATEST_DEPTH,
    "latest_pair": GetImage.Request.LATEST_PAIR,
    "queue_color": GetImage.Request.QUEUE_COLOR,
    "queue_depth": GetImage.Request.QUEUE_DEPTH,
    "queue_pair": GetImage.Request.QUEUE_PAIR,
    "queue_color_at_age": GetImage.Request.QUEUE_COLOR_AT_AGE,
    "queue_depth_at_age": GetImage.Request.QUEUE_DEPTH_AT_AGE,
    "queue_pair_at_age": GetImage.Request.QUEUE_PAIR_AT_AGE,
    "status": GetImage.Request.STATUS,
    "clear_queue": GetImage.Request.CLEAR_QUEUE,
}


def batch(node, args):
    client = node.create_client(GetImageBatch, args.service or "/rgbd_image_queue/get_image_batch")
    client.wait_for_service()
    request = GetImageBatch.Request(
        stream_id=args.stream_id, after_seq=args.after_seq, max_pairs=args.max_pairs)
    future = client.call_async(request)
    rclpy.spin_until_future_complete(node, future)
    result = future.result()
    fields = ("stream_id", "cursor_reset", "history_enabled", "snapshot_seq",
              "next_seq", "missing_count", "has_more", "latest_index")
    summary = {field: getattr(result, field) for field in fields}
    summary["pairs"] = [
        {"pair_id": pair.pair_id, "history_seq": pair.history_seq,
         "time": [pair.color.header.stamp.sec, pair.color.header.stamp.nanosec],
         "image_age_sec": pair.image_age_sec, "exceeded_max_age": pair.exceeded_max_age,
         "bytes": len(pair.color.data) + len(pair.depth.data)}
        for pair in result.pairs]
    summary["count"] = len(summary["pairs"])
    summary["bytes"] = sum(pair["bytes"] for pair in summary["pairs"])
    print(json.dumps(summary, ensure_ascii=False, indent=2))
    return 0


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("operation", choices=[*OPERATIONS, "batch"])
    parser.add_argument("detail", type=int, nargs="?", default=0,
                        help="QUEUE_*：从新到旧索引；*_AT_AGE：距当前毫秒数；其他操作忽略")
    parser.add_argument("--service")
    parser.add_argument("--stream-id", default="", help="batch：上次返回的 stream_id")
    parser.add_argument("--after-seq", type=int, default=0, help="batch：上次返回的 next_seq")
    parser.add_argument("--max-pairs", type=int, default=8, help="batch：包含最新对的总数上限")
    args = parser.parse_args()
    rclpy.init()
    node = rclpy.create_node("rgbd_queue_client")
    if args.operation == "batch":
        try:
            return batch(node, args)
        finally:
            node.destroy_node()
            rclpy.shutdown()
    service = args.service or "/rgbd_image_queue/get_image"
    client = node.create_client(GetImage, service)
    print("Waiting for " + service + " ...", flush=True)
    client.wait_for_service()
    request = GetImage.Request()
    request.operation = OPERATIONS[args.operation]
    request.detail = args.detail
    future = client.call_async(request)
    rclpy.spin_until_future_complete(node, future)
    result = future.result()
    fields = [
        "success", "message", "pair_id", "stamp_delta_sec", "image_age_sec",
        "exceeded_max_age", "queue_index", "age_error_sec", "queue_size", "latest_available", "latest_age_sec",
        "paired_count", "enqueued_count", "expired_count", "capacity_evicted_count",
        "retained_image_bytes",
    ]
    summary = {key: getattr(result, key) for key in fields}
    for name in ("color", "depth"):
        if getattr(result, "has_" + name):
            image = getattr(result, name)
            summary[name] = {
                "format": image.format,
                "frame_id": image.header.frame_id, "bytes": len(image.data),
                "stamp": [image.header.stamp.sec, image.header.stamp.nanosec],
            }
    print(json.dumps(summary, ensure_ascii=False, indent=2))
    node.destroy_node()
    rclpy.shutdown()
    return 0 if result.success else 1


if __name__ == "__main__":
    raise SystemExit(main())
